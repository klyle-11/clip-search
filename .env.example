# All settings are optional. Legacy JBP_* names are still read as fallbacks.
CLIPSEARCH_DB=data/clipsearch.db
# Default feed for `clipsearch ingest-rss` with no --feed (e.g. your private Patreon RSS URL)
CLIPSEARCH_RSS=
CLIPSEARCH_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
CLIPSEARCH_WHISPER_MODEL=medium
# Diarization (optional): HF token with the pyannote/speaker-diarization-3.1 + segmentation-3.0 terms accepted
HF_TOKEN=
CLIPSEARCH_DIARIZE_MODEL=pyannote/speaker-diarization-3.1
CLIPSEARCH_VOICE_MODEL=pyannote/wespeaker-voxceleb-resnet34-LM
# cosine needed to auto-match a cluster to a voiceprint; tune after a few episodes
CLIPSEARCH_VOICE_THRESHOLD=0.55
