# Your private Patreon RSS feed URL (Patreon > your membership > "Listen on other podcast apps")
JBP_PATREON_RSS=
JBP_DB=data/jbp.db
JBP_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
JBP_WHISPER_MODEL=medium
# Diarization: HF token with the pyannote/speaker-diarization-3.1 + segmentation-3.0 terms accepted
HF_TOKEN=
JBP_DIARIZE_MODEL=pyannote/speaker-diarization-3.1
JBP_VOICE_MODEL=pyannote/wespeaker-voxceleb-resnet34-LM
# cosine needed to auto-match a cluster to a voiceprint; tune after a few episodes
JBP_VOICE_THRESHOLD=0.55
